// ── INSTRUCTOR LIBRARY ────────────────────────────────────────────────────────

const IL_CATS = ['Instructor Manual','Terminology/Pronunciation','Curriculum','Forms','Weapons','Videos','General'];
const IL_TYPE_ICONS: Record<string,string> = {video:'▶',document:'📄',image:'🖼',link:'🔗',manual:'📖'};
const IL_TYPE_LABELS: Record<string,string> = {video:'Video',document:'Document',image:'Image',link:'Link',manual:'Manual'};

async function renderInstructorLibrary(el: HTMLElement) {
  el.innerHTML = '<p id="loading">Loading…</p>';
  let ilView: 'welcome'|'library'|'manage' = 'welcome';

  function closeILOverlays() {
    document.getElementById('il-video-overlay')?.remove();
    document.getElementById('il-pdf-overlay')?.remove();
    document.body.style.overflow = '';
  }

  function extractYTId(url: string) {
    for (const p of [/[?&]v=([^&#]+)/,/youtu\.be\/([^?&#]+)/,/youtube\.com\/embed\/([^?&#]+)/,/youtube\.com\/shorts\/([^?&#]+)/]) {
      const m = url.match(p); if (m) return m[1];
    }
    return null;
  }

  function openILVideo(url: string, title: string) {
    const id = extractYTId(url);
    if (!id) { window.open(url,'_blank'); return; }
    const ov = document.createElement('div');
    ov.id = 'il-video-overlay';
    ov.style.cssText = 'position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;padding:16px';
    ov.innerHTML = `<div id="il-vb" style="position:absolute;inset:0;background:rgba(0,0,0,.82)"></div>
      <div style="position:relative;z-index:1;width:100%;max-width:860px;background:var(--ink);border-radius:var(--r-lg);overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.6)">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--ink-2)">
          <span style="font-weight:700;font-size:.95rem;text-transform:uppercase;letter-spacing:.04em;color:var(--text-invert);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(title)}</span>
          <button id="il-vc" style="background:none;border:none;color:var(--text-invert-soft);font-size:1.1rem;cursor:pointer;padding:4px 6px">✕</button>
        </div>
        <div style="position:relative;padding-bottom:56.25%;height:0">
          <iframe src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0" style="position:absolute;inset:0;width:100%;height:100%" allowfullscreen allow="autoplay;encrypted-media" frameborder="0"></iframe>
        </div>
      </div>`;
    document.body.appendChild(ov);
    document.body.style.overflow = 'hidden';
    const close = () => { ov.remove(); document.body.style.overflow = ''; };
    document.getElementById('il-vc')!.addEventListener('click', close);
    document.getElementById('il-vb')!.addEventListener('click', close);
  }

  function openILPdf(id: string, title: string) {
    const ov = document.createElement('div');
    ov.id = 'il-pdf-overlay';
    ov.style.cssText = 'position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;padding:16px';
    ov.innerHTML = `<div id="il-pb" style="position:absolute;inset:0;background:rgba(0,0,0,.82)"></div>
      <div style="position:relative;z-index:1;width:100%;max-width:960px;height:90vh;background:var(--ink);border-radius:var(--r-lg);overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(0,0,0,.6)">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--ink-2);flex-shrink:0">
          <span style="font-weight:700;font-size:.95rem;text-transform:uppercase;letter-spacing:.04em;color:var(--text-invert);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(title)}</span>
          <div style="display:flex;gap:8px;align-items:center">
            <a href="/instructor-hub/file/${id}" download style="font-size:.75rem;font-weight:700;color:var(--text-invert-soft);border:1px solid rgba(255,255,255,.2);border-radius:var(--r);padding:4px 10px;text-decoration:none">Download</a>
            <button id="il-pc" style="background:none;border:none;color:var(--text-invert-soft);font-size:1.1rem;cursor:pointer;padding:4px 6px">✕</button>
          </div>
        </div>
        <iframe src="/instructor-hub/file/${id}" style="flex:1;width:100%;border:none;background:#fff" title="PDF Viewer"></iframe>
      </div>`;
    document.body.appendChild(ov);
    document.body.style.overflow = 'hidden';
    const close = () => { ov.remove(); document.body.style.overflow = ''; };
    document.getElementById('il-pc')!.addEventListener('click', close);
    document.getElementById('il-pb')!.addEventListener('click', close);
  }

  function tabBarHTML(allTabs: string[]) {
    return `
    <div class="il-tab-mobile">
      <select id="il-tab-select">
        ${allTabs.map(t=>`<option value="${esc(t)}">${esc(t)}</option>`).join('')}
      </select>
    </div>
    <div id="il-tabs" style="display:flex;gap:4px;border-bottom:2px solid var(--line);margin-bottom:24px;overflow-x:auto;scrollbar-width:none">
      ${allTabs.map((t,i) => `<button class="il-tab${i===0?' il-tab-on':''}" data-tab="${esc(t)}" style="flex-shrink:0;background:none;border:none;border-bottom:3px solid ${i===0?'var(--red)':'transparent'};margin-bottom:-2px;padding:10px 18px;font-size:.875rem;font-weight:600;color:${i===0?'var(--red)':'var(--text-soft)'};cursor:pointer">${esc(t)}</button>`).join('')}
    </div>`;
  }

  function wireTabBar(container: HTMLElement) {
    function applyTab(tab: string) {
      container.querySelectorAll<HTMLButtonElement>('.il-tab').forEach(b => {
        const on = b.dataset.tab === tab;
        b.classList.toggle('il-tab-on', on);
        b.style.color = on ? 'var(--red)' : 'var(--text-soft)';
        b.style.borderBottomColor = on ? 'var(--red)' : 'transparent';
      });
      const sel = container.querySelector<HTMLSelectElement>('#il-tab-select');
      if (sel) sel.value = tab;
      let vis = 0;
      container.querySelectorAll<HTMLElement>('.il-text-entry,.il-card').forEach(item => {
        const show = item.dataset.category === tab;
        item.style.display = show ? '' : 'none';
        if (show) vis++;
      });
      const empty = container.querySelector<HTMLElement>('#il-empty');
      if (empty) empty.style.display = vis === 0 ? '' : 'none';
    }

    container.querySelectorAll<HTMLButtonElement>('.il-tab').forEach(btn => {
      btn.addEventListener('click', () => applyTab(btn.dataset.tab!));
    });

    const tabSel = container.querySelector<HTMLSelectElement>('#il-tab-select');
    if (tabSel) tabSel.addEventListener('change', () => applyTab(tabSel.value));
  }

