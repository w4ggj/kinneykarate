    return `<div class="il-rte-toolbar" style="display:flex;gap:2px;flex-wrap:wrap;align-items:center;background:var(--paper-2);border:1px solid var(--line);border-bottom:none;border-radius:4px 4px 0 0;padding:4px 6px">
