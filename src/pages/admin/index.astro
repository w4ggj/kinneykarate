            <td style="white-space:nowrap">
              ${r.type==='text'?`<button class="act-btn il-edit-btn" data-id="${r.id}" data-title="${esc(r.title).replace(/"/g,'&quot;')}" data-content="${(r.content||'').replace(/"/g,'&quot;')}">Edit</button>`:''}
              ${r.active?`<button class="act-btn il-tog-btn" data-id="${r.id}" data-active="1">Hide</button>`:`<button class="act-btn act-btn--green il-tog-btn" data-id="${r.id}" data-active="0">Show</button>`}
              <button class="act-btn act-btn--red il-del-btn" data-id="${r.id}">Delete</button>
            </td>
          </tr>`).join('')}
        </tbody>
      </table></div>`}`;

    document.getElementById('il-to-library')!.addEventListener('click', showLibrary);
    wireRte(el, '.il-rte-toolbar', 'il-rte-editor');

    // Type select show/hide
    const typeEl = document.getElementById('il-type') as HTMLSelectElement;
    const urlGroup = document.getElementById('il-url-group')!;
    const fileGroup = document.getElementById('il-file-group')!;
    const contentGroup = document.getElementById('il-content-group')!;
    const urlLabel = document.getElementById('il-url-label')!;
    const urlInput = document.getElementById('il-url-input') as HTMLInputElement;
    function updateILFields() {
      const t = typeEl.value;
      const isFile = t==='document'||t==='manual'||t==='image';
      const isText = t==='text';
      urlGroup.style.display = (isFile||isText) ? 'none' : 'flex';
      fileGroup.style.display = isFile ? 'flex' : 'none';
      contentGroup.style.display = isText ? 'flex' : 'none';
      urlLabel.textContent = t==='link' ? 'URL' : 'YouTube URL';
      urlInput.placeholder = t==='link' ? 'https://…' : 'https://www.youtube.com/watch?v=…';
      urlInput.required = !isFile && !isText;
    }
    typeEl.addEventListener('change', updateILFields);

    // Form submit
    const form = document.getElementById('il-add-form') as HTMLFormElement;
    const errEl = document.getElementById('il-form-error')!;
    const okEl = document.getElementById('il-form-ok')!;
    const submitBtn = document.getElementById('il-submit') as HTMLButtonElement;
    form.addEventListener('submit', async e => {
      e.preventDefault();
      errEl.style.display = 'none'; okEl.style.display = 'none';
      submitBtn.disabled = true; submitBtn.textContent = 'Saving…';
      const rteEl = document.getElementById('il-rte-editor') as HTMLElement;
      (document.getElementById('il-content-hidden') as HTMLInputElement).value = rteEl?.innerHTML === '<br>' ? '' : (rteEl?.innerHTML ?? '');
      try {
        const res = await fetch('/instructor-hub/api/resources', { method: 'POST', body: new FormData(form) });
        const data = await res.json() as any;
        if (!res.ok) throw new Error(data.error ?? 'Failed');
        okEl.textContent = 'Resource added!'; okEl.style.display = 'block';
        form.reset(); if (rteEl) rteEl.innerHTML = ''; updateILFields();
        setTimeout(() => showManage(), 800);
      } catch(err: any) {
        errEl.textContent = err.message; errEl.style.display = 'block';
      } finally {
        submitBtn.disabled = false; submitBtn.textContent = 'Add Resource';
      }
    });

    // Table actions
    document.getElementById('il-tbody')?.addEventListener('click', async e => {
      const btn = (e.target as HTMLElement).closest('button') as HTMLButtonElement|null;
      if (!btn) return;
      const id = btn.dataset.id!;

      if (btn.classList.contains('il-edit-btn')) {
        const row = document.getElementById(`il-row-${id}`)!;
        if (row.querySelector('.il-inline-form')) return;
        const td = row.querySelector('td')!;
        const origTitle = btn.dataset.title ?? '';
        const origContent = btn.dataset.content ?? '';
        td.innerHTML = `<form class="il-inline-form" style="display:flex;flex-direction:column;gap:6px">
          <input class="il-ie-title" type="text" value="${origTitle.replace(/"/g,'&quot;')}" required style="width:100%;padding:6px 10px;border:1px solid var(--line);border-radius:var(--r);font-size:.875rem" />
          ${rteToolbarHTML('il-ie-rte')}
          <div style="display:flex;gap:8px;margin-top:4px">
            <button type="submit" class="act-btn act-btn--green">Save</button>
            <button type="button" class="il-cancel-edit act-btn">Cancel</button>
          </div>
        </form>`;
        const rteEl = td.querySelector('#il-ie-rte') as HTMLElement;
        rteEl.innerHTML = origContent;
        wireRte(td as HTMLElement, '.il-rte-toolbar', 'il-ie-rte');
        td.querySelector('.il-cancel-edit')!.addEventListener('click', () => showManage());
        td.querySelector('.il-inline-form')!.addEventListener('submit', async ev => {
          ev.preventDefault();
          const newTitle = (td.querySelector('.il-ie-title') as HTMLInputElement).value.trim();
          const newContent = rteEl.innerHTML === '<br>' ? '' : rteEl.innerHTML;
          const res = await fetch(`/instructor-hub/api/resources/${id}`, {
            method: 'PATCH', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ title: newTitle, content: newContent }),
          });
          if (!res.ok) { alert(await res.text()); return; }
          showManage();
        });
        return;
      }

      if (btn.classList.contains('il-tog-btn')) {
        const active = btn.dataset.active === '1' ? 0 : 1;
        btn.disabled = true;
        await fetch(`/instructor-hub/api/resources/${id}`, {
          method: 'PATCH', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ active }),
        });
        showManage();
        return;
      }

      if (btn.classList.contains('il-del-btn')) {
        if (!confirm('Delete this resource?')) return;
        btn.disabled = true;
        await fetch(`/instructor-hub/api/resources/${id}`, { method: 'DELETE' });
        document.getElementById(`il-row-${id}`)?.remove();
      }
    });
  }

  function showWelcome() {
    el.innerHTML = `
      <div style="max-width:700px;margin:0 auto;padding:40px 0">
        <h1 style="margin:0 0 8px">Instructor Library</h1>
        <p style="color:var(--text-soft);font-size:.95rem;margin:0 0 32px">Kinney Karate Instructor Resource Center</p>
        <div style="background:var(--paper);border:1px solid var(--line);border-radius:var(--r-lg);padding:28px 32px;margin-bottom:20px">
          <h2 style="font-size:1rem;text-transform:uppercase;letter-spacing:.06em;margin:0 0 12px">What is the Instructor Library?</h2>
          <p style="font-size:.95rem;line-height:1.7;color:var(--text);margin:0 0 12px">
            The Instructor Library is a private resource center for Kinney Karate instructors. It provides everything you need to teach effectively — from curriculum guides and forms to terminology references and training videos.
          </p>
          <p style="font-size:.95rem;line-height:1.7;color:var(--text);margin:0">
            All materials here are for instructor use only and should not be shared outside the school.
          </p>
        </div>
        <div style="background:var(--paper);border:1px solid var(--line);border-radius:var(--r-lg);padding:28px 32px;margin-bottom:28px">
          <h2 style="font-size:1rem;text-transform:uppercase;letter-spacing:.06em;margin:0 0 16px">What you'll find here</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
            ${[
              ['📖','Instructor Manual','Core teaching guidelines and school policies'],
              ['🗣','Terminology','Korean terminology and pronunciation guides'],
              ['🎓','Curriculum','Belt-level requirements and lesson plans'],
              ['📋','Forms','Poomsae and pattern references'],
              ['🥋','Weapons','Weapons curriculum and technique guides'],
              ['▶','Videos','Unlisted training and reference videos'],
            ].map(([icon,label,desc])=>`
              <div style="display:flex;gap:12px;align-items:flex-start;padding:12px;background:var(--paper-2);border-radius:var(--r)">
                <div style="font-size:1.3rem;flex-shrink:0">${icon}</div>
                <div>
                  <div style="font-weight:700;font-size:.85rem">${label}</div>
                  <div style="font-size:.8rem;color:var(--text-soft);line-height:1.4;margin-top:2px">${desc}</div>
                </div>
              </div>`).join('')}
          </div>
        </div>
        <div style="display:flex;gap:12px">
          <button class="btn" id="il-enter-library" style="font-size:1rem;padding:12px 28px">Enter Library →</button>
          <button class="btn btn-sm" id="il-to-manage" style="align-self:center">Manage Resources</button>
        </div>
      </div>`;
    document.getElementById('il-enter-library')!.addEventListener('click', showLibrary);
    document.getElementById('il-to-manage')!.addEventListener('click', showManage);
  }

  await showWelcome();
}

// Initial load
loadPanel('inventory');
</script>
)}

