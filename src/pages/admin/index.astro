.login-logo h1 { font-family: var(--font-condensed); text-transform: uppercase; font-size: 22px; font-weight: 700; margin-bottom: 2px; }
.login-logo p { font-size: 13px; color: var(--text-soft); }
.login-field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
.login-field label { font-size: 13px; font-weight: 600; }
.login-field input { border: 1px solid var(--line); border-radius: var(--r); padding: 10px 12px; font-size: 14px; width: 100%; }
.login-field input:focus { outline: 2px solid var(--red); border-color: transparent; outline-offset: 0; }
