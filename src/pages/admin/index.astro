      </div>
      ${tabBarHTML(allTabs)}
      <div id="il-text-entries">
        ${active.filter(r=>r.type==='text').map(r=>`
          <div class="il-text-entry" data-category="${esc(r.category||'General')}" style="background:var(--paper);border:1px solid var(--line);border-left:4px solid var(--red);border-radius:var(--r);padding:16px 20px;margin-bottom:16px">
            <div style="font-weight:700;font-size:.95rem;margin-bottom:8px;text-transform:uppercase;letter-spacing:.04em">${esc(r.title)}</div>
