      <button type="button" data-cmd="insertUnorderedList" style="background:none;border:1px solid transparent;border-radius:3px;padding:3px 8px;font-size:.8rem;cursor:pointer">• List</button>
      <button type="button" data-cmd="insertOrderedList" style="background:none;border:1px solid transparent;border-radius:3px;padding:3px 8px;font-size:.8rem;cursor:pointer">1. List</button>
      <span style="width:1px;background:var(--line);height:16px;margin:0 4px"></span>
      <button type="button" data-cmd="formatBlock" data-val="h3" style="background:none;border:1px solid transparent;border-radius:3px;padding:3px 8px;font-size:.8rem;cursor:pointer;font-weight:700">H</button>
      <button type="button" data-cmd="formatBlock" data-val="p" style="background:none;border:1px solid transparent;border-radius:3px;padding:3px 8px;font-size:.8rem;cursor:pointer">¶</button>
    </div>
    <div id="${idPrefix}" contenteditable="true" style="min-height:120px;padding:10px 12px;border:1px solid var(--line);border-radius:0 0 4px 4px;font-size:.9rem;line-height:1.6;background:#fff;outline:none;color:#111"></div>`;
  }

  function wireRte(container: HTMLElement, toolbarSelector: string, editorId: string) {
    container.querySelector(toolbarSelector)?.addEventListener('mousedown', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-cmd]');
      if (!btn) return;
      e.preventDefault();
      document.execCommand(btn.dataset.cmd!, false, btn.dataset.val ?? null);
      (container.querySelector(`#${editorId}`) as HTMLElement)?.focus();
    });
  }

