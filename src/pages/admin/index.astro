function showQRModal(url: string, itemName: string, priceCents: number) {
  const existing = document.getElementById('pos-qr-overlay');
  if (existing) existing.remove();

  const price = `$${(priceCents/100).toFixed(2)}`;
  const overlay = document.createElement('div');
  overlay.id = 'pos-qr-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:600;display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.innerHTML = `
    <div style="background:#fff;border-radius:16px;padding:32px 28px;width:100%;max-width:360px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.4)">
      <div style="font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#888;margin-bottom:6px">Point of Sale</div>
      <div style="font-size:20px;font-weight:800;margin-bottom:4px">${itemName}</div>
      <div style="font-size:32px;font-weight:900;color:#1a3a5c;margin-bottom:20px">${price}</div>
      <div id="pos-qr-container" style="display:flex;justify-content:center;margin-bottom:16px"></div>
      <p style="font-size:13px;color:#555;margin-bottom:20px;line-height:1.5">Customer: open your camera app and scan the code to pay on your own phone.</p>
      <div style="display:flex;gap:10px;justify-content:center">
        <button id="pos-qr-close" style="padding:10px 24px;border:1px solid #ddd;border-radius:8px;background:#fff;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit">Done</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);

  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
  document.getElementById('pos-qr-close')!.addEventListener('click', () => overlay.remove());

  // qrcodejs constructor: new QRCode(element, options)
  try {
    new (window as any).QRCode(document.getElementById('pos-qr-container'), {
      text: url,
      width: 240,
      height: 240,
      colorDark: '#000000',
      colorLight: '#ffffff',
      correctLevel: (window as any).QRCode.CorrectLevel.M,
    });
  } catch {
    const c = document.getElementById('pos-qr-container')!;
    c.innerHTML = `<div style="font-size:12px;word-break:break-all;color:#333;padding:8px">${url}</div>`;
  }
}

let qrLibLoaded = false;
function ensureQRLib(): Promise<void> {
  if (qrLibLoaded || (window as any).QRCode) { qrLibLoaded = true; return Promise.resolve(); }
  return new Promise((resolve, reject) => {
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
    s.onload = () => { qrLibLoaded = true; resolve(); };
    s.onerror = () => { qrLibLoaded = true; resolve(); }; // resolve anyway — fallback in showQRModal
    document.head.appendChild(s);
  });
}

async function renderPOS(el: HTMLElement) {
  // Fixed exam items + dynamic products from store
  const FIXED = [
    { id: 'exam-standard', name: 'Exam — Standard', price_cents: 3500, category: 'Exam', kind: 'simple', variants: [] as any[] },
    { id: 'exam-candidate', name: 'Exam — Candidate', price_cents: 5000, category: 'Exam', kind: 'simple', variants: [] as any[] },
  ];

  let storeProducts: any[] = [];
  try {
    storeProducts = await api('/admin/api/pos-products');
  } catch { /* ignore — fixed items still show */ }

  const allItems = [...FIXED, ...storeProducts];

  function productCard(p: any) {
    const price = p.price_cents ? `$${(p.price_cents/100).toFixed(0)}` : '';
    const hasVariants = p.variants && p.variants.length > 0;
    const variantSelect = hasVariants ? `
      <select data-pid="${esc(p.id)}" class="pos-size" style="margin-top:8px;width:100%;padding:6px 8px;border:1px solid var(--line);border-radius:var(--r);font-size:13px;font-family:inherit">
        <option value="">— select size —</option>
        ${p.variants.map((v: any) => {
          const label = [v.size, v.color].filter(Boolean).join(' / ') || 'Standard';
          const stockNote = v.on_hand !== undefined ? ` (${v.on_hand} in stock)` : '';
          return `<option value="${v.id}" data-price="${v.price_cents}">${esc(label)}${esc(stockNote)}</option>`;
        }).join('')}
      </select>` : '';
    const priceDisplay = hasVariants
      ? `<span class="pos-price-display" data-pid="${esc(p.id)}" style="font-size:18px;font-weight:700;color:var(--ink)">—</span>`
      : `<span style="font-size:18px;font-weight:700;color:var(--ink)">${price}</span>`;
    return `<div class="pos-card" data-pid="${esc(p.id)}" data-name="${esc(p.name)}" data-price="${p.price_cents||0}" data-fixed="${!hasVariants}" style="background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:18px;display:flex;flex-direction:column;gap:8px">
      <div style="font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-soft)">${esc(p.category||'Gear')}</div>
      <div style="font-size:15px;font-weight:700;line-height:1.3">${esc(p.name)}</div>
      ${variantSelect}
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px">
        ${priceDisplay}
        <button class="btn pos-charge-btn" data-pid="${esc(p.id)}" style="font-size:13px;padding:8px 18px">Charge</button>
      </div>
    </div>`;
  }

  el.innerHTML = `
    <h1>Point of Sale</h1>
    <p style="margin-bottom:24px;font-size:14px;color:var(--text-soft)">Tap Charge → a QR code appears → customer scans it with their own phone to pay.</p>
    <div id="pos-msg" style="display:none;margin-bottom:16px;padding:12px 16px;border-radius:var(--r);font-size:14px;font-weight:600"></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px">
      ${allItems.map(productCard).join('')}
    </div>`;

  el.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('.pos-charge-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const pid = btn.dataset.pid!;
    const card = el.querySelector(`.pos-card[data-pid="${pid}"]`) as HTMLElement;
    const item = allItems.find(p => String(p.id) === pid);
    if (!item) return;

    const msgEl = document.getElementById('pos-msg')!;
    const isFixed = card.dataset.fixed === 'true';

    let variantId: string | null = null;
    let priceCents: number;

    if (isFixed) {
      priceCents = item.price_cents;
    } else {
      const sel = card.querySelector('.pos-size') as HTMLSelectElement | null;
      if (!sel || !sel.value) {
        msgEl.textContent = 'Please select a size first.';
        msgEl.style.background = '#fef3c7'; msgEl.style.color = '#92400e';
        msgEl.style.display = 'block';
        setTimeout(() => { msgEl.style.display = 'none'; }, 3000);
        return;
      }
      variantId = sel.value;
      const opt = sel.options[sel.selectedIndex];
      priceCents = parseInt(opt.dataset.price || '0');
    }

    btn.disabled = true;
    btn.textContent = 'Loading…';
    msgEl.style.display = 'none';

    try {
      const res = await fetch('/admin/api/pos-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ item_id: pid, variant_id: variantId, price_cents: priceCents, name: item.name }),
      });
      const data = await res.json() as any;
      if (!res.ok) throw new Error(data.error || 'Checkout failed');

      // Show QR code modal — customer scans on their own phone
      await ensureQRLib();
      showQRModal(data.url, item.name, priceCents);
    } catch (err: any) {
      msgEl.textContent = err.message || 'Checkout failed.';
      msgEl.style.background = '#fee2e2'; msgEl.style.color = '#991b1b';
      msgEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Charge';
    }
  });

  // Update price display when size selected
  el.addEventListener('change', (e) => {
    const sel = (e.target as HTMLElement);
    if (!sel.classList.contains('pos-size')) return;
    const pid = (sel as HTMLSelectElement).dataset.pid!;
    const display = el.querySelector(`.pos-price-display[data-pid="${pid}"]`) as HTMLElement | null;
    if (!display) return;
    const opt = (sel as HTMLSelectElement).options[(sel as HTMLSelectElement).selectedIndex];
    const p = parseInt(opt.dataset.price || '0');
    display.textContent = p ? `$${(p/100).toFixed(0)}` : '—';
  });
}

