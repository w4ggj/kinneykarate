          </div>`).join('')}
      </div>
      <div id="il-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px">
        ${active.filter(r=>r.type!=='text').map(r=>{
          const isPdf = r.r2_key && (r.filename?.toLowerCase().endsWith('.pdf') || r.type==='manual' || r.type==='document');
          const isVideo = r.type==='video';
          return `<a href="${isVideo||isPdf?'#':(r.url||`/instructor-hub/file/${r.id}`)}"
            class="il-card" data-category="${esc(r.category||'General')}"
            ${isVideo?`data-video-url="${esc(r.url)}" data-video-title="${esc(r.title)}"`:''}
            ${isPdf?`data-pdf-id="${r.id}" data-pdf-title="${esc(r.title)}"`:''}
            ${r.url&&!isVideo&&!isPdf?'target="_blank" rel="noopener noreferrer"':''}
            style="display:flex;gap:14px;align-items:flex-start;background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:16px;text-decoration:none;color:var(--text);cursor:pointer">
            <div style="font-size:1.5rem;flex-shrink:0;padding-top:2px">${IL_TYPE_ICONS[r.type]??'📁'}</div>
            <div style="flex:1;min-width:0">
              <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--text-soft);margin-bottom:4px">${esc(IL_TYPE_LABELS[r.type]??r.type)}</div>
              <div style="font-weight:600;font-size:.95rem;margin-bottom:4px;line-height:1.3">${esc(r.title)}</div>
              ${r.description?`<div style="font-size:.8rem;color:var(--text-soft);line-height:1.4">${esc(r.description)}</div>`:''}
              ${r.filename?`<div style="font-size:.75rem;color:var(--text-soft);font-family:monospace">${esc(r.filename)}</div>`:''}
            </div>
            ${isVideo||isPdf?`<div style="font-size:.75rem;font-weight:700;color:var(--red);white-space:nowrap;align-self:center">${isVideo?'Watch →':'View →'}</div>`:''}
          </a>`;
        }).join('')}
      </div>
      <div id="il-empty" style="text-align:center;padding:60px 20px;color:var(--text-soft);${active.length?'display:none':''}">No resources yet.</div>`;

    wireTabBar(el);
    document.getElementById('il-to-welcome')!.addEventListener('click', showWelcome);
    document.getElementById('il-to-manage')!.addEventListener('click', showManage);
    // Apply first tab filter on initial render
    el.querySelector<HTMLButtonElement>('.il-tab')?.click();
    el.querySelector('#il-grid')!.addEventListener('click', e => {
      const vc = (e.target as HTMLElement).closest<HTMLElement>('[data-video-url]');
      if (vc) { e.preventDefault(); openILVideo(vc.dataset.videoUrl!, vc.dataset.videoTitle??''); return; }
      const pc = (e.target as HTMLElement).closest<HTMLElement>('[data-pdf-id]');
      if (pc) { e.preventDefault(); openILPdf(pc.dataset.pdfId!, pc.dataset.pdfTitle??''); }
    });
  }

