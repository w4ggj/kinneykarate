---
export const prerender = false;
import InstructorBase from '../../layouts/InstructorBase.astro';

const cookie = Astro.cookies.get('kk_instructor_session');
if (cookie?.value !== 'authenticated') {
  return Astro.redirect('/instructor-hub/');
}

const env = (Astro.locals as any).runtime?.env;
let resources: any[] = [];
let dbError = '';

if (env?.DB) {
  try {
    const result = await env.DB.prepare(
      'SELECT * FROM instructor_resources WHERE active = 1 ORDER BY sort_order, created_at DESC'
    ).all();
    resources = result.results ?? [];
  } catch (e: any) {
    dbError = e.message;
  }
}

// Build ordered tab list: All + unique categories sorted, Videos and Instructor Manual first
const rawCats = [...new Set(resources.map((r: any) => r.category || 'General'))];
const prioritized = ['Videos', 'Instructor Manual'];
const cats = [
  ...prioritized.filter(c => rawCats.includes(c)),
  ...rawCats.filter(c => !prioritized.includes(c)).sort(),
];
const allTabs = cats.length > 0 ? ['All', ...cats] : ['All'];

const typeIcon: Record<string, string> = {
  video: '▶',
  document: '📄',
  image: '🖼',
  link: '🔗',
  manual: '📖',
};
const typeLabel: Record<string, string> = {
  video: 'Video',
  document: 'Document',
  image: 'Image',
  link: 'Link',
  manual: 'Manual',
};
---
<InstructorBase title="Instructor Library" authed={true}>
  <div class="page-header">
    <div>
      <h1 class="page-title cond">Instructor Library</h1>
      <p class="page-sub">Resources, manuals, and training materials for Kinney Karate instructors.</p>
    </div>
  </div>

  {dbError && <div class="db-error">Database error: {dbError}</div>}

  {resources.length === 0 && !dbError ? (
    <div class="empty-state">
      <p>No resources yet.</p>
      <a href="/instructor-hub/admin" class="btn">Add your first resource →</a>
    </div>
  ) : (
    <>
      <!-- Tab bar -->
      <div class="tab-bar" role="tablist">
        {allTabs.map((tab, i) => (
          <button
            class={`tab-btn${i === 0 ? ' tab-btn--active' : ''}`}
            role="tab"
            data-tab={tab}
            aria-selected={i === 0 ? 'true' : 'false'}
          >{tab}</button>
        ))}
      </div>

      <!-- Resource grid — all cards rendered, JS shows/hides by category -->
      <div class="resource-grid" id="resource-grid">
        {resources.map((r: any) => (
          <a
            href={r.url || `/instructor-hub/file/${r.id}`}
            class={`resource-card resource-card--${r.type}`}
            data-category={r.category || 'General'}
            target={r.url ? '_blank' : undefined}
            rel={r.url ? 'noopener noreferrer' : undefined}
          >
            <div class="resource-icon">{typeIcon[r.type] ?? '📁'}</div>
            <div class="resource-body">
              <div class="resource-type">{typeLabel[r.type] ?? r.type}</div>
              <div class="resource-title">{r.title}</div>
              {r.description && <div class="resource-desc">{r.description}</div>}
              {r.filename && <div class="resource-filename">{r.filename}</div>}
            </div>
            {r.type === 'video' && (
              <div class="resource-play">Watch →</div>
            )}
            {(r.type === 'document' || r.type === 'manual') && r.r2_key && (
              <div class="resource-play">Download →</div>
            )}
          </a>
        ))}
      </div>

      <div class="empty-tab" id="empty-tab" style="display:none">
        <p>Nothing in this category yet.</p>
      </div>
    </>
  )}
</InstructorBase>

<script>
const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
const cards = document.querySelectorAll<HTMLElement>('.resource-card');
const emptyMsg = document.getElementById('empty-tab')!;

function switchTab(tab: string) {
  tabs.forEach(btn => {
    const active = btn.dataset.tab === tab;
    btn.classList.toggle('tab-btn--active', active);
    btn.setAttribute('aria-selected', active ? 'true' : 'false');
  });
  let visible = 0;
  cards.forEach(card => {
    const show = tab === 'All' || card.dataset.category === tab;
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  emptyMsg.style.display = visible === 0 ? '' : 'none';
}

tabs.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab!)));
</script>

<style>
  .page-header { margin-bottom: 28px; }
  .page-title { font-size: 2rem; margin-bottom: 6px; }
  .page-sub { color: var(--text-soft); font-size: .95rem; }

  .db-error {
    background: #fef2f2; border: 1px solid #fca5a5; color: var(--danger);
    border-radius: var(--r); padding: 12px 16px; margin-bottom: 24px; font-size: .875rem;
  }
  .empty-state {
    text-align: center; padding: 80px 20px; color: var(--text-soft);
  }
  .empty-state p { margin-bottom: 16px; font-size: 1.05rem; }
  .empty-tab { text-align: center; padding: 60px 20px; color: var(--text-soft); font-size: .95rem; }

  /* Tab bar */
  .tab-bar {
    display: flex;
    gap: 4px;
    border-bottom: 2px solid var(--line);
    margin-bottom: 28px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .tab-bar::-webkit-scrollbar { display: none; }
  .tab-btn {
    flex-shrink: 0;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    padding: 10px 18px;
    font-family: var(--font-body);
    font-size: .875rem;
    font-weight: 600;
    color: var(--text-soft);
    cursor: pointer;
    transition: color .15s, border-color .15s;
    border-radius: var(--r) var(--r) 0 0;
  }
  .tab-btn:hover { color: var(--text); }
  .tab-btn--active { color: var(--red); border-bottom-color: var(--red); }

  /* Resource grid */
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  .resource-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 16px;
    text-decoration: none;
    color: var(--text);
    transition: box-shadow .15s, border-color .15s;
    cursor: pointer;
  }
  .resource-card:hover { border-color: var(--red); box-shadow: 0 2px 12px rgba(0,0,0,.08); }
  .resource-icon { font-size: 1.5rem; line-height: 1; flex-shrink: 0; padding-top: 2px; }
  .resource-body { flex: 1; min-width: 0; }
  .resource-type {
    font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
    color: var(--text-soft); margin-bottom: 4px;
  }
  .resource-card--video .resource-type { color: var(--red); }
  .resource-card--manual .resource-type { color: var(--ok); }
  .resource-title { font-weight: 600; font-size: .95rem; margin-bottom: 4px; line-height: 1.3; }
  .resource-desc { font-size: .8rem; color: var(--text-soft); line-height: 1.4; margin-bottom: 4px; }
  .resource-filename { font-size: .75rem; color: var(--text-soft); font-family: var(--font-mono); }
  .resource-play {
    font-size: .75rem; font-weight: 700; color: var(--red); white-space: nowrap;
    align-self: center; flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .resource-grid { grid-template-columns: 1fr; }
    .page-title { font-size: 1.5rem; }
    .tab-btn { padding: 10px 14px; font-size: .8rem; }
  }
</style>
