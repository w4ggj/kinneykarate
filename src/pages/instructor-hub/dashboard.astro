---
export const prerender = false;
import InstructorBase from '../../layouts/InstructorBase.astro';

const cookie = Astro.cookies.get('kk_instructor_session');
if (cookie?.value !== 'authenticated') {
  return Astro.redirect('/instructor-hub/');
}

const env = (Astro.locals as any).runtime?.env;
let resources: any[] = [];
let dbError = '';

if (env?.DB) {
  try {
    const result = await env.DB.prepare(
      'SELECT * FROM instructor_resources WHERE active = 1 ORDER BY sort_order, created_at DESC'
    ).all();
    resources = result.results ?? [];
  } catch (e: any) {
    dbError = e.message;
  }
}

// Fixed base tabs always shown; extra tabs added for any other categories in use
const baseCats = ['Instructor Manual', 'Terminology/Pronunciation', 'Curriculum', 'Forms', 'Weapons', 'Videos', 'General'];
const extraCats = [...new Set(resources.map((r: any) => r.category || 'General'))]
  .filter(c => !baseCats.includes(c)).sort();
const allTabs = ['All', ...baseCats, ...extraCats];

const typeIcon: Record<string, string> = {
  video: '▶',
  document: '📄',
  image: '🖼',
  link: '🔗',
  manual: '📖',
};
const typeLabel: Record<string, string> = {
  video: 'Video',
  document: 'Document',
  image: 'Image',
  link: 'Link',
  manual: 'Manual',
};
---
<InstructorBase title="Instructor Library" authed={true}>
  <div class="page-header">
    <div>
      <h1 class="page-title cond">Instructor Library</h1>
      <p class="page-sub">Resources, manuals, and training materials for Kinney Karate instructors.</p>
    </div>
  </div>

  {dbError && <div class="db-error">Database error: {dbError}</div>}

  {!dbError && (
    <>
      <!-- Tab bar -->
      <div class="tab-bar" role="tablist">
        {allTabs.map((tab, i) => (
          <button
            class={`tab-btn${i === 0 ? ' tab-btn--active' : ''}`}
            role="tab"
            data-tab={tab}
            aria-selected={i === 0 ? 'true' : 'false'}
          >{tab}</button>
        ))}
      </div>

      <!-- Video overlay -->
      <div id="video-overlay" class="video-overlay" aria-modal="true" role="dialog" style="display:none">
        <div class="video-backdrop"></div>
        <div class="video-modal">
          <div class="video-modal-header">
            <span id="video-modal-title" class="video-modal-title"></span>
            <button id="video-close" class="video-close" aria-label="Close">✕</button>
          </div>
          <div class="video-wrap">
            <iframe id="video-iframe" src="" allowfullscreen allow="autoplay; encrypted-media" frameborder="0"></iframe>
          </div>
        </div>
      </div>

      <!-- PDF viewer overlay -->
      <div id="pdf-overlay" class="pdf-overlay" aria-modal="true" role="dialog" style="display:none">
        <div class="pdf-backdrop"></div>
        <div class="pdf-modal">
          <div class="pdf-modal-header">
            <span id="pdf-modal-title" class="video-modal-title"></span>
            <div style="display:flex;gap:8px;align-items:center">
              <a id="pdf-download-link" href="#" class="pdf-download-btn" download>Download</a>
              <button id="pdf-close" class="video-close" aria-label="Close">✕</button>
            </div>
          </div>
          <iframe id="pdf-iframe" src="" class="pdf-iframe" title="PDF Viewer"></iframe>
        </div>
      </div>

      <!-- Resource grid — all cards rendered, JS shows/hides by category -->
      <div class="resource-grid" id="resource-grid">
        {resources.map((r: any) => {
          const isPdf = r.r2_key && (r.filename?.toLowerCase().endsWith('.pdf') || r.type === 'manual' || r.type === 'document');
          const isVideo = r.type === 'video';
          return (
          <a
            href={isVideo ? '#' : (isPdf ? '#' : (r.url || `/instructor-hub/file/${r.id}`))}
            class={`resource-card resource-card--${r.type}`}
            data-category={r.category || 'General'}
            data-video-url={isVideo ? r.url : undefined}
            data-video-title={isVideo ? r.title : undefined}
            data-pdf-id={isPdf ? r.id : undefined}
            data-pdf-title={isPdf ? r.title : undefined}
            target={r.url && !isVideo && !isPdf ? '_blank' : undefined}
            rel={r.url && !isVideo && !isPdf ? 'noopener noreferrer' : undefined}
          >
            <div class="resource-icon">{typeIcon[r.type] ?? '📁'}</div>
            <div class="resource-body">
              <div class="resource-type">{typeLabel[r.type] ?? r.type}</div>
              <div class="resource-title">{r.title}</div>
              {r.description && <div class="resource-desc">{r.description}</div>}
              {r.filename && <div class="resource-filename">{r.filename}</div>}
            </div>
            {isVideo && <div class="resource-play">Watch →</div>}
            {isPdf && <div class="resource-play">View →</div>}
          </a>
          );
        })}
      </div>

      <div class="empty-tab" id="empty-tab" style={resources.length === 0 ? '' : 'display:none'}>
        <p>Nothing here yet. <a href="/instructor-hub/admin">Add a resource →</a></p>
      </div>
    </>
  )}
</InstructorBase>

<script>
// Tabs
const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
const cards = document.querySelectorAll<HTMLElement>('.resource-card');
const emptyMsg = document.getElementById('empty-tab')!;

function switchTab(tab: string) {
  tabs.forEach(btn => {
    const active = btn.dataset.tab === tab;
    btn.classList.toggle('tab-btn--active', active);
    btn.setAttribute('aria-selected', active ? 'true' : 'false');
  });
  let visible = 0;
  cards.forEach(card => {
    const show = tab === 'All' || card.dataset.category === tab;
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  emptyMsg.style.display = visible === 0 ? '' : 'none';
}
tabs.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab!)));

// Video overlay
const overlay = document.getElementById('video-overlay')!;
const iframe = document.getElementById('video-iframe') as HTMLIFrameElement;
const titleEl = document.getElementById('video-modal-title')!;
const closeBtn = document.getElementById('video-close')!;

function extractYouTubeId(url: string): string | null {
  const patterns = [
    /[?&]v=([^&#]+)/,
    /youtu\.be\/([^?&#]+)/,
    /youtube\.com\/embed\/([^?&#]+)/,
    /youtube\.com\/shorts\/([^?&#]+)/,
  ];
  for (const p of patterns) {
    const m = url.match(p);
    if (m) return m[1];
  }
  return null;
}

function openVideo(url: string, title: string) {
  const id = extractYouTubeId(url);
  if (!id) { window.open(url, '_blank'); return; }
  iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
  titleEl.textContent = title;
  overlay.style.display = '';
  document.body.style.overflow = 'hidden';
}

function closeVideo() {
  overlay.style.display = 'none';
  iframe.src = '';
  document.body.style.overflow = '';
}

closeBtn.addEventListener('click', closeVideo);
overlay.querySelector('.video-backdrop')!.addEventListener('click', closeVideo);
document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeVideo(); closePdf(); } });

// PDF overlay
const pdfOverlay = document.getElementById('pdf-overlay')!;
const pdfIframe = document.getElementById('pdf-iframe') as HTMLIFrameElement;
const pdfTitle = document.getElementById('pdf-modal-title')!;
const pdfClose = document.getElementById('pdf-close')!;
const pdfDownload = document.getElementById('pdf-download-link') as HTMLAnchorElement;

function openPdf(id: string, title: string) {
  const src = `/instructor-hub/file/${id}`;
  pdfIframe.src = src;
  pdfDownload.href = src;
  pdfTitle.textContent = title;
  pdfOverlay.style.display = '';
  document.body.style.overflow = 'hidden';
}
function closePdf() {
  pdfOverlay.style.display = 'none';
  pdfIframe.src = '';
  document.body.style.overflow = '';
}
pdfClose.addEventListener('click', closePdf);
pdfOverlay.querySelector('.pdf-backdrop')!.addEventListener('click', closePdf);

document.getElementById('resource-grid')!.addEventListener('click', e => {
  const pdfCard = (e.target as HTMLElement).closest<HTMLElement>('[data-pdf-id]');
  if (pdfCard) { e.preventDefault(); openPdf(pdfCard.dataset.pdfId!, pdfCard.dataset.pdfTitle ?? ''); return; }
  const videoCard = (e.target as HTMLElement).closest<HTMLElement>('[data-video-url]');
  if (videoCard) { e.preventDefault(); openVideo(videoCard.dataset.videoUrl!, videoCard.dataset.videoTitle ?? ''); }
});
</script>

<style>
  .page-header { margin-bottom: 28px; }
  .page-title { font-size: 2rem; margin-bottom: 6px; }
  .page-sub { color: var(--text-soft); font-size: .95rem; }

  .db-error {
    background: #fef2f2; border: 1px solid #fca5a5; color: var(--danger);
    border-radius: var(--r); padding: 12px 16px; margin-bottom: 24px; font-size: .875rem;
  }
  .empty-state {
    text-align: center; padding: 80px 20px; color: var(--text-soft);
  }
  .empty-state p { margin-bottom: 16px; font-size: 1.05rem; }
  .empty-tab { text-align: center; padding: 60px 20px; color: var(--text-soft); font-size: .95rem; }

  /* Tab bar */
  .tab-bar {
    display: flex;
    gap: 4px;
    border-bottom: 2px solid var(--line);
    margin-bottom: 28px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .tab-bar::-webkit-scrollbar { display: none; }
  .tab-btn {
    flex-shrink: 0;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    padding: 10px 18px;
    font-family: var(--font-body);
    font-size: .875rem;
    font-weight: 600;
    color: var(--text-soft);
    cursor: pointer;
    transition: color .15s, border-color .15s;
    border-radius: var(--r) var(--r) 0 0;
  }
  .tab-btn:hover { color: var(--text); }
  .tab-btn--active { color: var(--red); border-bottom-color: var(--red); }

  /* Resource grid */
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  .resource-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 16px;
    text-decoration: none;
    color: var(--text);
    transition: box-shadow .15s, border-color .15s;
    cursor: pointer;
  }
  .resource-card:hover { border-color: var(--red); box-shadow: 0 2px 12px rgba(0,0,0,.08); }
  .resource-icon { font-size: 1.5rem; line-height: 1; flex-shrink: 0; padding-top: 2px; }
  .resource-body { flex: 1; min-width: 0; }
  .resource-type {
    font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
    color: var(--text-soft); margin-bottom: 4px;
  }
  .resource-card--video .resource-type { color: var(--red); }
  .resource-card--manual .resource-type { color: var(--ok); }
  .resource-title { font-weight: 600; font-size: .95rem; margin-bottom: 4px; line-height: 1.3; }
  .resource-desc { font-size: .8rem; color: var(--text-soft); line-height: 1.4; margin-bottom: 4px; }
  .resource-filename { font-size: .75rem; color: var(--text-soft); font-family: var(--font-mono); }
  .resource-play {
    font-size: .75rem; font-weight: 700; color: var(--red); white-space: nowrap;
    align-self: center; flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .resource-grid { grid-template-columns: 1fr; }
    .page-title { font-size: 1.5rem; }
    .tab-btn { padding: 10px 14px; font-size: .8rem; }
  }

  /* Video overlay */
  .video-overlay {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    padding: 16px;
  }
  .video-backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,.82);
  }
  .video-modal {
    position: relative; z-index: 1;
    width: 100%; max-width: 860px;
    background: var(--ink);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,.6);
  }
  .video-modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 16px;
    background: var(--ink-2);
  }
  .video-modal-title {
    font-family: var(--font-condensed);
    font-weight: 700; font-size: .95rem;
    text-transform: uppercase; letter-spacing: .04em;
    color: var(--text-invert);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .video-close {
    background: none; border: none; color: var(--text-invert-soft);
    font-size: 1.1rem; cursor: pointer; line-height: 1; padding: 4px 6px;
    border-radius: 4px; flex-shrink: 0; transition: color .15s;
  }
  .video-close:hover { color: var(--text-invert); }
  .video-wrap {
    position: relative; padding-bottom: 56.25%; /* 16:9 */
    height: 0;
  }
  .video-wrap iframe {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  @media (max-width: 480px) {
    .video-overlay { padding: 0; align-items: flex-end; }
    .video-modal { border-radius: var(--r-lg) var(--r-lg) 0 0; max-width: 100%; }
  }

  /* PDF overlay */
  .pdf-overlay {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    padding: 16px;
  }
  .pdf-backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,.82);
  }
  .pdf-modal {
    position: relative; z-index: 1;
    width: 100%; max-width: 960px; height: 90vh;
    background: var(--ink);
    border-radius: var(--r-lg);
    overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 24px 60px rgba(0,0,0,.6);
  }
  .pdf-modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 16px;
    background: var(--ink-2);
    flex-shrink: 0;
  }
  .pdf-download-btn {
    font-size: .75rem; font-weight: 700;
    color: var(--text-invert-soft);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: var(--r);
    padding: 4px 10px;
    text-decoration: none;
    transition: color .15s;
  }
  .pdf-download-btn:hover { color: var(--text-invert); }
  .pdf-iframe {
    flex: 1; width: 100%; border: none; background: #fff;
  }
  @media (max-width: 480px) {
    .pdf-overlay { padding: 0; align-items: flex-end; }
    .pdf-modal { border-radius: var(--r-lg) var(--r-lg) 0 0; height: 92vh; max-width: 100%; }
  }
</style>
