---
export const prerender = false;
import InstructorBase from '../../layouts/InstructorBase.astro';

const cookie = Astro.cookies.get('kk_instructor_session');
if (cookie?.value !== 'authenticated') {
  return Astro.redirect('/instructor-hub/');
}

const env = (Astro.locals as any).runtime?.env;
let resources: any[] = [];
let dbError = '';

if (env?.DB) {
  try {
    const result = await env.DB.prepare(
      'SELECT * FROM instructor_resources WHERE active = 1 ORDER BY category, sort_order, created_at DESC'
    ).all();
    resources = result.results ?? [];
  } catch (e: any) {
    dbError = e.message;
  }
}

// Group by category
const grouped: Record<string, any[]> = {};
for (const r of resources) {
  const cat = r.category || 'General';
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(r);
}
const categories = Object.keys(grouped).sort((a, b) =>
  a === 'General' ? -1 : b === 'General' ? 1 : a.localeCompare(b)
);

const typeIcon: Record<string, string> = {
  video: '▶',
  document: '📄',
  image: '🖼',
  link: '🔗',
  manual: '📖',
};
const typeLabel: Record<string, string> = {
  video: 'Video',
  document: 'Document',
  image: 'Image',
  link: 'Link',
  manual: 'Manual',
};
---
<InstructorBase title="Instructor Library" authed={true}>
  <div class="page-header">
    <div>
      <h1 class="page-title cond">Instructor Library</h1>
      <p class="page-sub">Resources, manuals, and training materials for Kinney Karate instructors.</p>
    </div>
  </div>

  {dbError && <div class="db-error">Database error: {dbError}</div>}

  {resources.length === 0 && !dbError && (
    <div class="empty-state">
      <p>No resources yet.</p>
      <a href="/instructor-hub/admin" class="btn">Add your first resource →</a>
    </div>
  )}

  {categories.map(cat => (
    <section class="category-section">
      <h2 class="category-title kick">{cat}</h2>
      <div class="resource-grid">
        {grouped[cat].map((r: any) => (
          <a
            href={r.url || `/instructor-hub/file/${r.id}`}
            class={`resource-card resource-card--${r.type}`}
            target={r.url ? '_blank' : undefined}
            rel={r.url ? 'noopener noreferrer' : undefined}
          >
            <div class="resource-icon">{typeIcon[r.type] ?? '📁'}</div>
            <div class="resource-body">
              <div class="resource-type">{typeLabel[r.type] ?? r.type}</div>
              <div class="resource-title">{r.title}</div>
              {r.description && <div class="resource-desc">{r.description}</div>}
              {r.filename && <div class="resource-filename">{r.filename}</div>}
            </div>
            {r.type === 'video' && (
              <div class="resource-play">Watch →</div>
            )}
            {(r.type === 'document' || r.type === 'manual') && r.r2_key && (
              <div class="resource-play">Download →</div>
            )}
          </a>
        ))}
      </div>
    </section>
  ))}
</InstructorBase>

<style>
  .page-header { margin-bottom: 36px; }
  .page-title { font-size: 2rem; margin-bottom: 6px; }
  .page-sub { color: var(--text-soft); font-size: .95rem; }

  .db-error {
    background: #fef2f2; border: 1px solid #fca5a5; color: var(--danger);
    border-radius: var(--r); padding: 12px 16px; margin-bottom: 24px; font-size: .875rem;
  }
  .empty-state {
    text-align: center; padding: 80px 20px; color: var(--text-soft);
  }
  .empty-state p { margin-bottom: 16px; font-size: 1.05rem; }

  .category-section { margin-bottom: 48px; }
  .category-title { font-size: .8rem; margin-bottom: 16px; }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  @media (max-width: 480px) {
    .resource-grid { grid-template-columns: 1fr; }
    .page-title { font-size: 1.5rem; }
  }
  .resource-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 16px;
    text-decoration: none;
    color: var(--text);
    transition: box-shadow .15s, border-color .15s;
    cursor: pointer;
  }
  .resource-card:hover { border-color: var(--red); box-shadow: 0 2px 12px rgba(0,0,0,.08); }
  .resource-icon { font-size: 1.5rem; line-height: 1; flex-shrink: 0; padding-top: 2px; }
  .resource-body { flex: 1; min-width: 0; }
  .resource-type {
    font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
    color: var(--text-soft); margin-bottom: 4px;
  }
  .resource-card--video .resource-type { color: var(--red); }
  .resource-card--manual .resource-type { color: var(--ok); }
  .resource-title { font-weight: 600; font-size: .95rem; margin-bottom: 4px; line-height: 1.3; }
  .resource-desc { font-size: .8rem; color: var(--text-soft); line-height: 1.4; margin-bottom: 4px; }
  .resource-filename { font-size: .75rem; color: var(--text-soft); font-family: var(--font-mono); }
  .resource-play {
    font-size: .75rem; font-weight: 700; color: var(--red); white-space: nowrap;
    align-self: center; flex-shrink: 0;
  }
</style>
